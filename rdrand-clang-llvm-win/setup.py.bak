from setuptools import setup, Extension
import sysconfig
import os

# Force clang GCC-frontend mode regardless of environment
os.environ['CC'] = r'D:\Programs\clang\bin\clang.exe'
os.environ['CXX'] = r'D:\Programs\clang\bin\clang++.exe'
os.environ['LDSHARED'] = r'D:\Programs\clang\bin\clang.exe -shared'

# Get the correct include directory for the active Python
#python_include = sysconfig.get_path('include')

# Create extension with correct paths
#rdrand_ext = Extension(
#    '_rdrand',
#    sources=['rdrand.c'],
#    include_dirs=[python_include],
#)

#setup(
#    ext_modules=[rdrand_ext],
#)

python_include = sysconfig.get_path('include')

rdrand_ext = Extension(
    '_rdrand',
    sources=['rdrand.c'],
    include_dirs=[python_include],
    extra_compile_args=['-mrdrnd', '-mrdseed', '-O2'],
)

setup(ext_modules=[rdrand_ext])
